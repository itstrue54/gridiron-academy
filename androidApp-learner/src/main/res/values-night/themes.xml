<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GridironAcademy" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
    </style>
    <!-- Launch: the icon on the surface until the lessons have loaded (MainActivity). -->
    <style name="Theme.GridironAcademy.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/surface</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.GridironAcademy</item>
    </style>
    <!-- Floodlight surface. -->
    <color name="surface">#0F1B16</color>
</resources>
