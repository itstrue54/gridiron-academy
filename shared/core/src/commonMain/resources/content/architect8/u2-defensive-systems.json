          "type": "match",
          "id": "ar8-defense-06",
          "prompt": "Match each defense to its idea.",
          "pairs": [
            {
              "left": "Two-high, light box",
              "right": "Take away big plays, invite the run"
            },
            {
              "left": "Tampa 2",
              "right": "Mike carries the deep middle"
            },
            {
              "left": "46",
              "right": "Overload the line with a Bear front"
            },
            {
              "left": "3-3-5",
              "right": "Five defensive backs, three stacked linebackers"
            }
          ],
          "explanation": "Defenses, too, choose what to give up.",
          "concept": "defensive-system"
        },
        {
          "type": "multiple_choice",
          "id": "ar8-defense-07",
          "prompt": "A two-high, light-box defense is daring the offense to do what?",
          "choices": [
            "Run the ball",
            "Throw deep",
            "Punt",
            "Kick field goals"
          ],
          "answer": 0,
          "explanation": "Fewer defenders near the line makes running more attractive, which is the trade it accepts.",
          "concept": "defensive-system"
        }
      ]
    },
    {
      "id": "ar8-matchups",
      "title": "Scheme vs Scheme",
      "blurb": "When systems collide.",
      "steps": [
        {
          "type": "learn",
          "id": "ar8-matchups-01",
          "title": "Every scheme has a price",
          "body": "Each system takes something away and gives something up. Game planning is finding where their price meets your strength.",
          "concept": "defensive-system"
        },
        {
          "type": "multiple_choice",
          "id": "ar8-matchups-02",
          "prompt": "Your offense runs wide zone. The opponent plays Wide-9. Where should you attack?",
          "choices": [
            "Inside, through the wider interior lanes",
            "Only the deep sideline",
            "Kneel every down",
            "Directly at the ends"
          ],
          "answer": 0,
          "explanation": "With the ends that wide, the interior gaps are bigger; cutbacks and inside runs get room.",
          "concept": "wide-nine"
        },
        {
          "type": "multiple_choice",
          "id": "ar8-matchups-03",
          "prompt": "The opponent plays the 46 with a Bear front. What is it most vulnerable to?",
          "choices": [
            "Quick throws to the outside",
            "Inside runs",
            "Quarterback sneaks",
            "Short field goals"
          ],
          "answer": 0,
          "explanation": "It loads the middle to stop runs and pressure the quarterback; quick throws outside beat it before the rush arrives.",
          "concept": "bear-front"
        },
        {
          "type": "multiple_choice",
          "id": "ar8-matchups-04",
          "prompt": "Against a two-high, light-box defense, what does a smart offense often do more of?",
          "choices": [
            "Run the ball",
            "Throw deep every play",
            "Punt earlier",
            "Use max protect"
          ],
          "answer": 0,
          "explanation": "That defense invites the run; good offenses accept the invitation.",
          "concept": "defensive-system"
        },
        {
          "type": "multiple_choice",
          "id": "ar8-matchups-05",
          "prompt": "Your Air Raid offense faces a lot of man coverage. Which staple concept fits?",
          "choices": [
            "Mesh",
            "Four verticals against Cover 3",
            "Inside zone",
            "Kneel down"
          ],
          "answer": 0,
          "explanation": "Mesh's crossing routes rub man defenders off their receivers.",
          "concept": "mesh"
        }
      ]
    }
  ]
