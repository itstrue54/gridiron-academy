  "lessons": [
    {
      "id": "ar8-offense",
      "title": "Offensive Systems",
      "blurb": "How whole offenses are built.",
      "steps": [
        {
          "type": "learn",
          "id": "ar8-offense-01",
          "title": "West Coast",
          "body": "Short, timed throws used like an extension of the run game. The quarterback's drop is matched to the route depth, and receivers are expected to run after the catch.",
          "concept": "offensive-system"
        },
        {
          "type": "learn",
          "id": "ar8-offense-02",
          "title": "Air Coryell",
          "body": "A vertical passing attack built on a numbered route tree, pushing the ball downfield with deep and intermediate routes timed to longer drops.",
          "concept": "offensive-system"
        },
        {
          "type": "learn",
          "id": "ar8-offense-03",
          "title": "Erhardt-Perkins",
          "body": "Plays named by concept, not formation, so the same concept can be called from any personnel or alignment. Easy to adapt week to week.",
          "concept": "offensive-system"
        },
        {
          "type": "learn",
          "id": "ar8-offense-04",
          "title": "Air Raid and run-and-shoot",
          "body": "Air Raid spreads the field and repeats a small set of pass concepts (mesh, Y-cross, four verticals) until they're perfect. Run-and-shoot lets receivers adjust routes to the coverage after the snap.",
          "concept": "offensive-system"
        },
        {
          "type": "learn",
          "id": "ar8-offense-05",
          "title": "Wide zone and play-action",
          "body": "An outside-zone run game that stretches the defense sideways, paired with bootlegs and play-action that look identical to the run.",
