      "blurb": "Sacks, hits, blitzes and stunts.",
      "steps": [
        {
          "type": "learn",
          "id": "v4-pressure-01",
          "title": "Sack, hit, hurry",
          "body": "A sack is tackling the quarterback behind the line before he throws. A QB hit is contact as or after he throws. A hurry forces him to throw early or move. Together they are pressures.",
          "concept": "sack"
        },
        {
          "type": "learn",
          "id": "v4-pressure-02",
          "title": "Blitz and stunt",
          "body": "A blitz sends five or more rushers, usually a linebacker or defensive back joining the line. A stunt (or twist) has linemen swap paths to confuse blockers.",
          "concept": "blitz"
        },
        {
          "type": "multiple_choice",
          "id": "v4-pressure-03",
          "prompt": "The quarterback is tackled behind the line before he throws. What is it?",
