      "id": "v4-zone",
      "title": "Zone Runs",
      "blurb": "Block an area, let the back find the hole.",
      "steps": [
        {
          "type": "learn",
          "id": "v4-zone-01",
          "title": "Zone blocking",
          "body": "On a zone run every lineman steps the same way and blocks whoever enters his area, often with two linemen combining before one climbs to a linebacker. The back reads the blocks and picks the hole.",
          "concept": "zone-run"
        },
        {
          "type": "learn",
          "id": "v4-zone-02",
          "title": "Inside zone",
