      "blurb": "Managing the clock to score.",
      "steps": [
        {
          "type": "learn",
          "id": "a3-twominute-01",
          "title": "What stops the clock",
          "body": "In the NFL: an incomplete pass, a timeout, a score, the two-minute warning, and a player going out of bounds. A first down does not stop the NFL clock.",
          "concept": "two-minute-drill"
        },
        {
          "type": "learn",
          "id": "a3-twominute-02",
          "title": "Out of bounds, late",
          "body": "In the last two minutes of the first half and the last five minutes of the game, the clock stays stopped after a runner goes out of bounds until the next snap. Otherwise it restarts once the ball is spotted.",
          "concept": "game-clock"
        },
        {
          "type": "multiple_choice",
          "id": "a3-twominute-03",
          "prompt": "In the NFL, does a first down stop the game clock?",
          "choices": [
            "No",
            "Yes, until the next snap",
            "Only in overtime",
            "Only on 4th down"
          ],
          "answer": 0,
          "explanation": "Not in the NFL. In college, first downs stop the clock briefly late in each half.",
          "concept": "game-clock"
        },
