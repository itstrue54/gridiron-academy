  "lessons": [
    {
      "id": "a3-tree",
      "title": "The Route Tree",
      "blurb": "Nine routes and how they're numbered.",
      "steps": [
        {
          "type": "learn",
          "id": "a3-tree-01",
          "title": "A numbered menu",
          "body": "Many offenses number their routes so a call can name them fast. In one common tree: 1 flat, 2 slant, 3 comeback, 4 curl, 5 out, 6 dig, 7 corner, 8 post, 9 go. Systems differ.",
          "concept": "route-tree"
        },
        {
          "type": "learn",
          "id": "a3-tree-02",
          "title": "Odd out, even in",
          "body": "In that tree the odd numbers break toward the sideline and the even numbers break toward the middle. The higher the number, the deeper the route.",
          "concept": "route-tree"
        },
        {
          "type": "learn",
          "id": "a3-tree-03",
          "title": "Dig and comeback",
