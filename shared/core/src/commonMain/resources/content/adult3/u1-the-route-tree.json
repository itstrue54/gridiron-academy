    {
      "id": "a3-timing",
      "title": "Stems, Breaks and Timing",
      "blurb": "Why the depth of a route matters.",
      "steps": [
        {
          "type": "learn",
          "id": "a3-timing-01",
          "title": "Stem and break",
          "body": "Every route has a stem, the run before the cut, and a break, the cut itself. A good stem makes the defender guess which way the break will go.",
          "concept": "route"
        },
        {
          "type": "learn",
          "id": "a3-timing-02",
          "title": "Matched to the drop",
          "body": "Routes are timed to the quarterback's drop: quick three-step throws for slants and hitches, five-step drops for curls, outs and digs, longer drops or play-action for posts, corners and go routes.",
          "concept": "route"
        },
        {
          "type": "multiple_choice",
          "id": "a3-timing-03",
          "prompt": "Which route pairs with a quick three-step drop?",
          "choices": [
            "Slant",
            "Post",
            "Corner",
            "Go"
          ],
          "answer": 0,
          "explanation": "The slant is a quick-game throw: the ball comes out on the third step.",
          "concept": "route"
        },
        {
          "type": "multiple_choice",
          "id": "a3-timing-04",
          "prompt": "Which part of a route is meant to make the defender guess?",
          "choices": [
            "The stem",
            "The huddle",
            "The snap count",
            "The catch"
          ],
          "answer": 0,
          "explanation": "A stem that could become several routes keeps the defender from jumping the break.",
          "concept": "route"
        },
        {
          "type": "true_false",
          "id": "a3-timing-05",
          "statement": "Deep routes like the post usually need more time than the quick game.",
          "answer": true,
          "explanation": "Yes. Deeper routes take longer to develop, so they pair with longer drops or play-action.",
          "concept": "route"
        }
      ]
    },
