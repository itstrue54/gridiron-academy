      "id": "c5-option",
      "title": "Option Football",
      "blurb": "Reading a defender instead of blocking him.",
      "steps": [
        {
          "type": "learn",
          "id": "c5-option-01",
          "title": "Why read?",
          "body": "Option plays leave one defender unblocked on purpose. The quarterback reads him and makes whichever choice he can't defend. It's an extra blocker without a blocker.",
          "concept": "option"
        },
        {
          "type": "learn",
          "id": "c5-option-02",
          "title": "Zone read",
