{
  "id": "college5-u2",
  "title": "Tempo, Splits and Motion",
  "lessons": [
    {
      "id": "c5-tempo",
      "title": "Tempo and Splits",
      "blurb": "Speed and spacing as weapons.",
      "steps": [
        {
          "type": "learn",
          "id": "c5-tempo-01",
          "title": "Tempo",
          "body": "Snapping the ball quickly, without a huddle, stops the defense from substituting and gives it less time to disguise or call a complex blitz.",
          "concept": "tempo"
        },
        {
          "type": "learn",
          "id": "c5-tempo-02",
          "title": "Check with me",
          "body": "Some no-huddle offenses line up fast, then look to the sideline or let the quarterback pick the play once the defense shows its look.",
          "concept": "tempo"
        },
        {
          "type": "learn",
          "id": "c5-tempo-03",
          "title": "Splits",
          "body": "Wide splits between linemen or receivers stretch the defense and open creases. Tight splits pull defenders in and set up crack blocks and rubs.",
          "concept": "splits"
        },
        {
          "type": "multiple_choice",
          "id": "c5-tempo-04",
          "prompt": "Why play fast after a big gain?",
          "choices": [
            "The tired defense can't substitute",
            "To get a penalty",
            "To end the half",
            "To save timeouts for the defense"
          ],
          "answer": 0,
          "explanation": "Snapping before the defense can sub keeps tired players on the field.",
          "concept": "tempo"
        },
        {
          "type": "true_false",
          "id": "c5-tempo-05",
          "statement": "Tight receiver splits can set up rub routes and crack blocks.",
          "answer": true,
          "explanation": "Bunched receivers create traffic for defenders and angles for blockers.",
          "concept": "splits"
        }
      ]
    },
