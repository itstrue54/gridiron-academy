      "id": "p6-presnap",
      "title": "Pre-Snap Reads",
      "blurb": "What the quarterback checks before the ball is snapped.",
      "steps": [
        {
          "type": "learn",
          "id": "p6-presnap-01",
          "title": "The order",
          "body": "Safeties first (one high or two), then corners (depth and leverage), then the box (how many defenders near the line), then any motion check.",
          "concept": "safety-position"
        },
