        {
          "type": "multiple_choice",
          "id": "p6-presnap-05",
          "prompt": "Six blockers against eight in the box. What's the smart check?",
          "choices": [
            "Throw: the defense has run defenders to spare",
            "Run: more defenders leave more gaps open",
            "Run at the side with the extra defender",
            "Keep running until they back off"
          ],
          "answer": 0,
          "explanation": "Eight in the box means fewer in coverage and more than you can block on a run.",
          "concept": "box-count"
        },
        {
          "type": "multiple_choice",
          "id": "p6-presnap-06",
          "prompt": "A receiver goes in motion and the corner runs with him. What does that suggest?",
          "choices": [
            "Man coverage",
            "Zone coverage",
            "A run blitz is impossible",
            "Nothing at all"
          ],
          "answer": 0,
          "explanation": "A defender who travels with motion is usually in man. A clue, not a promise.",
          "concept": "motion"
        },
        {
          "type": "true_false",
          "id": "p6-presnap-07",
          "statement": "Two high safeties usually mean more defenders near the line.",
          "answer": false,
          "explanation": "Two deep leaves one fewer defender for the box, which is why runs look better against two-high shells.",
          "concept": "mofo"
        }
      ]
