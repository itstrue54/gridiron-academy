{
  "id": "pro6-u1",
  "title": "Personnel and Packages",
  "lessons": [
    {
      "id": "p6-groupings",
      "title": "Every Personnel Grouping",
      "blurb": "From empty to jumbo.",
      "steps": [
        {
          "type": "learn",
          "id": "p6-groupings-01",
          "title": "The full menu",
          "body": "Backs then tight ends: 00, 01 and 02 empty the backfield; 10 and 11 spread it; 12, 13, 21, 22 and 23 bring more blockers. Jumbo adds a sixth offensive lineman for short yardage.",
          "concept": "personnel"
        },
        {
          "type": "learn",
          "id": "p6-groupings-02",
          "title": "What it signals",
          "body": "Lighter groupings (10, 11, 00) lean pass and pull defensive backs onto the field. Heavier ones (12, 13, 21, 22, jumbo) lean run and invite linebackers. Good offenses run and pass from the same grouping to break the pattern.",
          "concept": "personnel"
        },
        {
          "type": "multiple_choice",
          "id": "p6-groupings-03",
          "prompt": "How many wide receivers are in 01 personnel?",
          "choices": [
            "4",
            "3",
            "5",
            "2"
          ],
          "answer": 0,
          "explanation": "0 backs + 1 tight end = 1, so 5 - 1 = 4 receivers, with an empty backfield.",
          "concept": "personnel"
        },
        {
          "type": "multiple_choice",
          "id": "p6-groupings-04",
          "prompt": "How many wide receivers are in 23 personnel?",
          "choices": [
            "0",
            "1",
            "2",
            "3"
          ],
          "answer": 0,
          "explanation": "2 backs + 3 tight ends = 5: no receivers at all. A goal-line grouping.",
          "concept": "personnel"
        },
        {
          "type": "match",
          "id": "p6-groupings-05",
          "prompt": "Match each grouping to its usual purpose.",
          "pairs": [
            {
              "left": "Jumbo",
              "right": "Short yardage with a sixth lineman"
            },
            {
              "left": "10",
              "right": "Four receivers to spread the field"
            },
            {
              "left": "22",
              "right": "Heavy run with two backs and two tight ends"
            },
            {
              "left": "00",
              "right": "Five receivers, empty backfield"
            }
          ],
          "explanation": "The grouping tells you what the offense probably wants, and good offenses use that against you.",
          "concept": "personnel"
        },
        {
          "type": "true_false",
          "id": "p6-groupings-06",
          "statement": "Good offenses run and pass from the same personnel to keep defenses guessing.",
          "answer": true,
          "explanation": "If a grouping always meant one thing, defenses would just match it.",
          "concept": "personnel"
        }
      ]
    },
