    {
      "id": "a1-turnovers",
      "title": "Turnovers and Kicking",
      "steps": [
        {
          "type": "learn",
          "id": "a1-turnovers-01",
          "title": "Turnovers",
          "body": "An interception (a defender catches a forward pass) and a fumble recovered by the defense are turnovers. A turnover on downs is when the offense fails to convert on 4th down.",
          "concept": "turnover"
        },
        {
          "type": "learn",
          "id": "a1-turnovers-02",
          "title": "Kicks",
          "body": "A kickoff starts each half and follows every score. A punt gives the ball away on 4th down for field position. A field goal is a kick for points. A touchback on a punt or an interception in the end zone puts the ball at the 20-yard line.",
          "concept": "special-teams"
        },
        {
          "type": "multiple_choice",
          "id": "a1-turnovers-03",
          "prompt": "Which of these is NOT a turnover?",
          "choices": [
            "Interception",
            "Fumble lost to the defense",
            "Punt",
            "Turnover on downs"
          ],
          "answer": 2,
          "explanation": "A punt is a choice. Turnovers are lost possessions without a kick.",
          "concept": "turnover"
        },
        {
          "type": "true_false",
          "id": "a1-turnovers-04",
          "statement": "A fumble can be recovered by either team.",
          "answer": true,
          "explanation": "Whichever team recovers the loose ball gets possession.",
          "concept": "fumble"
        },
        {
          "type": "multiple_choice",
          "id": "a1-turnovers-05",
          "prompt": "A punt rolls into the end zone and a player downs it there. Where does the receiving team start?",
          "choices": [
            "The 10-yard line",
            "The 20-yard line",
            "The 25-yard line",
            "The goal line"
          ],
          "answer": 1,
          "explanation": "A touchback on a punt is placed at the 20.",
          "concept": "touchback"
        },
        {
          "type": "multiple_choice",
          "id": "a1-turnovers-06",
          "prompt": "Which score is worth 3 points?",
          "choices": [
            "Safety",
            "Field goal",
            "Extra point",
            "Two-point conversion"
          ],
          "answer": 1,
          "explanation": "A field goal is worth 3.",
          "concept": "field-goal"
        }
      ],
      "blurb": "How possession changes."
    }
