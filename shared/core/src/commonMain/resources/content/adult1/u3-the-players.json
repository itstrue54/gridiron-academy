{
  "id": "adult1-u3",
  "title": "The Players",
  "lessons": [
    {
      "id": "a1-positions",
      "title": "Positions and Formations",
      "steps": [
        {
          "type": "learn",
          "id": "a1-positions-01",
          "title": "Offense",
          "body": "The quarterback (QB) runs the offense. Running backs (RB) carry the ball. Receivers (WR) and tight ends (TE) catch passes. Five offensive linemen (LT, LG, C, RG, RT) block. Who may catch a forward pass depends on where a player lines up, not just his position: the two players on the ends of the line and the players in the backfield.",
          "concept": "offensive-line"
        },
        {
          "type": "learn",
          "id": "a1-positions-02",
          "title": "Defense",
          "body": "Defensive linemen (DL) rush the passer and stop the run. Linebackers (LB) do both and cover. Cornerbacks (CB) and safeties (S) defend the pass. Common arrangement: 4 DL, 3 LB, 2 CB, 2 S.",
          "concept": "defense-positions"
        },
        {
          "type": "learn",
          "id": "a1-positions-03",
          "title": "At the line",
          "body": "At the snap, the offense must have at least seven players on the line of scrimmage, and all of its players must be set (no moving) except one in motion who must be moving sideways or backward.",
          "concept": "line-of-scrimmage"
        },
        {
          "type": "match",
          "id": "a1-positions-04",
          "prompt": "Match position to job.",
          "pairs": [
            {
              "left": "QB",
              "right": "Takes the snap and throws or hands off"
            },
            {
              "left": "TE",
              "right": "Blocks and catches passes"
            },
            {
              "left": "LB",
              "right": "Defender who tackles and covers"
            },
            {
              "left": "CB",
              "right": "Covers wide receivers"
            },
            {
              "left": "S",
              "right": "Deep defender, last line of defense"
            }
          ],
          "explanation": "Tight ends are the hybrid position: part lineman, part receiver.",
          "concept": "defense-positions"
        },
