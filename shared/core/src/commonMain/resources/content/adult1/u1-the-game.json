{
  "id": "adult1-u1",
  "title": "The Game in Five Minutes",
  "lessons": [
    {
      "id": "a1-basics",
      "title": "The Game in Five Minutes",
      "steps": [
        {
          "type": "learn",
          "id": "a1-basics-01",
          "title": "The field",
          "body": "The playing field is 100 yards between the goal lines, plus a 10-yard end zone at each end, and 53 1/3 yards wide. You score by getting the ball into the opponent's end zone.",
          "concept": "field"
        },
        {
          "type": "learn",
          "id": "a1-basics-02",
          "title": "Offense, defense, special teams",
          "body": "The team with the ball is the offense; the other is the defense. Each puts 11 players on the field. Kicking plays (kickoffs, punts, field goals) are run by special teams. Flag football, played from youth leagues up to the 2028 Olympics, replaces tackling with pulling a flag off the ball carrier's belt.",
          "concept": "offense"
        },
        {
          "type": "learn",
          "id": "a1-basics-03",
          "title": "The clock",
          "body": "A game is four 15-minute quarters. The first two quarters are the first half, the last two the second half, with a halftime break between.",
          "concept": "quarter"
        },
        {
          "type": "multiple_choice",
          "id": "a1-basics-04",
          "prompt": "How long is the field from goal line to goal line?",
          "choices": [
            "80 yards",
            "100 yards",
            "120 yards",
            "110 yards"
          ],
          "answer": 1,
          "explanation": "The field is 100 yards between goal lines. With both 10-yard end zones the total length is 120 yards.",
          "concept": "field"
        },
        {
          "type": "multiple_choice",
          "id": "a1-basics-05",
          "prompt": "How many players does each team have on the field at a time?",
          "choices": [
            "9",
            "10",
            "11",
            "12"
          ],
          "answer": 2,
          "explanation": "Eleven a side. Having 12 on the field is a penalty.",
          "concept": "offense"
        },
        {
          "type": "true_false",
          "id": "a1-basics-06",
          "statement": "A kickoff is run by the offense.",
          "answer": false,
          "explanation": "Kickoffs, punts and field goals are special teams plays.",
          "concept": "special-teams"
        },
        {
          "type": "multiple_choice",
          "id": "a1-basics-07",
          "prompt": "How many quarters are in an NFL game, and how long is each?",
          "choices": [
            "4 quarters of 12 minutes",
            "4 quarters of 15 minutes",
            "2 halves of 30 minutes with no quarters",
            "3 periods of 20 minutes"
          ],
          "answer": 1,
          "explanation": "Four 15-minute quarters make 60 minutes of game time. High school uses 12-minute quarters; college uses 15.",
          "concept": "quarter"
        },
        {
          "type": "true_false",
          "id": "a1-basics-08",
          "statement": "The 50-yard line is the exact middle of the playing field.",
          "answer": true,
          "explanation": "It sits 50 yards from each goal line.",
          "concept": "yard-line"
        },
        {
          "type": "multiple_choice",
          "id": "a1-basics-09",
          "prompt": "Where does the offense have to get the ball to score a touchdown?",
          "choices": [
            "The opponent's end zone",
            "Past midfield",
            "Inside the 10-yard line",
            "Through the uprights"
          ],
          "answer": 0,
          "explanation": "A touchdown is the ball in the opponent's end zone, carried across the goal line or caught there. Through the uprights is a kick.",
          "concept": "endzone"
        },
        {
          "type": "true_false",
          "id": "a1-basics-10",
          "statement": "The defense is the team with the ball.",
          "answer": false,
          "explanation": "The offense has the ball; the defense tries to stop it and take it away.",
          "concept": "defense"
        },
        {
          "type": "multiple_choice",
          "id": "a1-basics-11",
          "prompt": "How does a running play usually end?",
          "choices": [
            "The ball carrier is tackled, goes out of bounds, or scores",
            "The ball carrier crosses the line of scrimmage",
            "The runner gains 10 yards for a first down",
            "A defender touches the runner with one hand"
          ],
          "answer": 0,
          "explanation": "A play is over when the runner is down (tackled), out of bounds, or in the end zone.",
          "concept": "tackle"
        },
        {
          "type": "true_false",
          "id": "a1-basics-12",
          "statement": "In flag football, you stop the ball carrier by pulling a flag from their belt.",
          "answer": true,
          "explanation": "Pulling the flag ends the play, so there is no tackling.",
          "concept": "flag-football"
        }
      ],
      "blurb": "Field, teams, clock."
    },
