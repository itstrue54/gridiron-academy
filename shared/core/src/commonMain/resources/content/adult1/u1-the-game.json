          "id": "a1-scoring-05",
          "prompt": "From where is a two-point conversion attempted in the NFL?",
          "choices": [
            "The 1-yard line",
            "The 2-yard line",
            "The 3-yard line",
            "The 5-yard line"
          ],
          "answer": 1,
