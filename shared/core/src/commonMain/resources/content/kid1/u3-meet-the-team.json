    {
      "id": "k1-flag",
      "title": "Flag or Tackle?",
      "steps": [
        {
          "type": "learn",
          "id": "k1-flag-01",
          "title": "Flag football",
          "body": "Many kids start with flag football. Players wear flags on a belt. To stop a runner, you pull the flag. No tackling!",
          "concept": "flag-football"
        },
        {
          "type": "learn",
          "id": "k1-flag-02",
          "title": "Tackle football",
          "body": "In tackle football, players wear helmets and pads and can tackle. Youth tackle leagues use rules a lot like high school football's, with some changes for younger players.",
          "concept": "tackle"
        },
        {
          "type": "multiple_choice",
          "id": "k1-flag-03",
          "prompt": "In flag football, how do you stop the ball carrier?",
          "choices": [
            "Tackle them",
            "Pull their flag",
            "Tap their helmet",
            "Blow a whistle"
          ],
          "answer": 1,
          "explanation": "Pulling the flag ends the play, just like a tackle would.",
          "concept": "flag-football"
        },
        {
          "type": "true_false",
          "id": "k1-flag-04",
          "statement": "Players tackle each other to the ground in flag football.",
          "answer": false,
          "explanation": "Flag football has no tackling.",
          "concept": "flag-football"
        },
        {
          "type": "true_false",
          "id": "k1-flag-05",
          "statement": "The rules can be a little different in each league.",
          "answer": true,
          "explanation": "Always ask your coach about your league's rules.",
          "concept": "flag-football"
        }
      ],
      "blurb": "Two ways to play."
    },
    {
      "id": "k1-refs",
      "title": "Referees and Flags",
      "steps": [
        {
          "type": "learn",
          "id": "k1-refs-01",
          "title": "Penalty",
          "body": "Referees make sure everyone follows the rules. If a player breaks a rule, the referee throws a yellow flag. That is a penalty.",
          "concept": "penalty"
        },
        {
          "type": "learn",
          "id": "k1-refs-02",
          "title": "Common penalties",
          "body": "A false start is an offensive player moving too early, before the snap. Offside is a defender crossing the line too early. The team that broke the rule usually loses yards.",
          "concept": "false-start"
        },
        {
          "type": "learn",
          "id": "k1-refs-03",
          "title": "Touchdown signal",
          "body": "When a team scores a touchdown, the referee holds both arms straight up in the air.",
          "concept": "referee"
        },
        {
          "type": "multiple_choice",
          "id": "k1-refs-04",
          "prompt": "What color flag does a referee throw for a penalty?",
          "choices": [
            "Yellow",
            "Blue",
            "Green",
            "Pink"
          ],
          "answer": 0,
          "explanation": "A yellow flag means a penalty.",
          "concept": "penalty"
        },
        {
          "type": "multiple_choice",
          "id": "k1-refs-05",
          "prompt": "A player on offense moves too early, before the snap. What penalty is that?",
          "choices": [
            "Fumble",
            "False start",
            "Field goal",
            "Touchdown"
          ],
          "answer": 1,
          "explanation": "Moving too early on offense is a false start.",
          "concept": "false-start"
        },
        {
          "type": "true_false",
          "id": "k1-refs-06",
          "statement": "A penalty means someone broke a rule.",
          "answer": true,
          "explanation": "The yellow flag tells everyone a rule was broken.",
          "concept": "penalty"
        },
        {
          "type": "multiple_choice",
          "id": "k1-refs-07",
          "prompt": "The referee holds both arms straight up. What happened?",
          "choices": [
            "Touchdown",
            "Penalty",
            "Fumble",
            "Timeout"
          ],
          "answer": 0,
          "explanation": "Both arms up is the touchdown signal.",
          "concept": "touchdown"
        }
      ],
      "blurb": "Keeping the game fair."
    }
