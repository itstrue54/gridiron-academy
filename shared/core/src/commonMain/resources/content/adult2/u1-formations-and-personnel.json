                "y": 0
              },
              {
                "id": "qb",
                "label": "QB",
                "side": "OFFENSE",
                "x": 0,
                "y": -5
              },
              {
                "id": "rb",
                "label": "RB",
                "side": "OFFENSE",
                "x": 1.8,
                "y": -5
              },
              {
                "id": "te",
                "label": "TE",
                "side": "OFFENSE",
