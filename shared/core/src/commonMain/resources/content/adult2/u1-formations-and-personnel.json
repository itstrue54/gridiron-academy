    {
      "id": "a2-eligibility",
      "title": "Who Can Catch a Pass",
      "blurb": "Eligible and ineligible receivers.",
      "steps": [
        {
          "type": "learn",
          "id": "a2-eligibility-01",
          "title": "Seven on the line",
          "body": "The offense must have at least seven players on the line of scrimmage at the snap. Fewer is an illegal formation: 5 yards.",
          "concept": "line-of-scrimmage"
        },
        {
          "type": "learn",
          "id": "a2-eligibility-02",
          "title": "Who is eligible",
          "body": "The two players at the ends of the line, and every player in the backfield, are eligible to catch a forward pass. The interior linemen are not, and in the NFL neither is a quarterback taking the snap under center.",
          "concept": "eligible-receiver"
        },
        {
          "type": "learn",
          "id": "a2-eligibility-03",
          "title": "Numbers tell the story",
          "body": "In the NFL, offensive linemen wear 50 to 79. A player in one of those numbers who lines up to catch passes must report to the referee as eligible first.",
          "concept": "ineligible-receiver"
        },
        {
          "type": "diagram_tap",
          "id": "a2-eligibility-04",
          "prompt": "Tap every player who is NOT allowed to catch a forward pass.",
          "diagram": {
