{
  "id": "coordinator7-u5",
  "title": "The Defense's Answers",
  "lessons": [
    {
      "id": "co7-defense",
      "title": "The Defense's Answers",
      "blurb": "Checks, match rules and communication.",
      "steps": [
        {
          "type": "learn",
          "id": "co7-defense-01",
          "title": "Coverage checks",
          "body": "A defense may call two coverages in the huddle and pick one at the line based on the formation or motion. Some systems color-code them: 'red' means one coverage, 'green' another.",
          "concept": "coverage-check"
        },
        {
          "type": "learn",
          "id": "co7-defense-02",
          "title": "Match rules",
          "body": "Pattern-matching zones have rules for when a defender passes a receiver off and when he locks on. Disguised looks only work if every defender knows his rule after the rotation.",
          "concept": "pattern-matching"
        },
        {
          "type": "learn",
          "id": "co7-defense-03",
          "title": "Against tempo",
          "body": "When the offense hurries, defenses use one-word calls and simple 'check-with-me' rules so they can line up fast without giving away the coverage.",
          "concept": "coverage-check"
        },
        {
          "type": "multiple_choice",
          "id": "co7-defense-04",
          "prompt": "A defense calls 'red' or 'green' at the line after seeing the formation. What is that?",
          "choices": [
            "A coverage check",
            "A snap count",
            "A penalty",
            "A timeout"
          ],
          "answer": 0,
          "explanation": "It's a check: two coverages called, one chosen at the line.",
          "concept": "coverage-check"
        },
        {
          "type": "true_false",
          "id": "co7-defense-05",
          "statement": "Disguise only works if every defender knows his job after the rotation.",
          "answer": true,
          "explanation": "A rotation with one player out of position leaves a receiver wide open.",
          "concept": "disguise"
        }
      ]
    },
