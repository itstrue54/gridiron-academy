  "lessons": [
    {
      "id": "k2-line",
      "title": "The Line of Scrimmage",
      "blurb": "Where every play starts.",
      "steps": [
        {
          "type": "learn",
          "id": "k2-line-01",
          "title": "The line of scrimmage",
          "body": "Before each play, the ball sits on an invisible line across the field: the line of scrimmage. Neither team may cross it until the ball is snapped.",
          "concept": "line-of-scrimmage"
        },
        {
          "type": "multiple_choice",
          "id": "k2-line-02",
          "prompt": "Where does the ball sit before a play starts?",
          "choices": [
            "On the line of scrimmage",
            "In the end zone",
            "Always on the 50-yard line",
            "Next to the coach"
          ],
          "answer": 0,
          "explanation": "The ball is placed where the last play ended, or back where it started after an incomplete pass. That spot is the new line of scrimmage.",
          "concept": "line-of-scrimmage"
        },
        {
          "type": "learn",
          "id": "k2-line-03",
          "title": "Formations",
