      "id": "k2-kickoff",
      "title": "The Kickoff",
      "blurb": "How every half begins.",
      "steps": [
        {
          "type": "learn",
          "id": "k2-kickoff-01",
          "title": "Kickoff!",
          "body": "A kickoff starts each half of the game. One team kicks the ball far down the field, and the other team catches it and runs it back.",
          "concept": "kickoff"
        },
        {
          "type": "learn",
          "id": "k2-kickoff-02",
          "title": "After a score",
          "body": "Kickoffs also happen after a touchdown or a field goal. The team that just scored kicks the ball to the other team.",
          "concept": "kickoff"
        },
        {
          "type": "learn",
          "id": "k2-kickoff-03",
          "title": "The returner",
