          "title": "Ten yards",
          "body": "The ball must go 10 yards before the kicking team can grab it, unless the other team touches it first. The other team can grab it any time.",
          "concept": "onside-kick"
        },
        {
          "type": "multiple_choice",
          "id": "k2-onside-03",
          "prompt": "Why would a team try an onside kick?",
          "choices": [
            "To get the ball back",
            "To score a touchdown",
            "To start the game",
            "To end the quarter"
          ],
          "answer": 0,
          "explanation": "An onside kick is a way to try to keep the ball, usually when a team is behind late in the game.",
          "concept": "onside-kick"
        },
        {
          "type": "true_false",
          "id": "k2-onside-04",
          "statement": "On an onside kick, the kicking team can grab the ball after it goes 10 yards.",
          "answer": true,
          "explanation": "Before 10 yards, only the other team may grab it.",
          "concept": "onside-kick"
        },
        {
          "type": "multiple_choice",
          "id": "k2-onside-05",
          "prompt": "When do teams most often try onside kicks?",
          "choices": [
            "When they are winning big",
            "When they are losing near the end",
            "On the first kick of the game",
            "Every kickoff"
          ],
          "answer": 1,
          "explanation": "A team that is behind late needs the ball back, so the risk is worth it.",
          "concept": "onside-kick"
        },
        {
          "type": "true_false",
