        {
          "type": "multiple_choice",
          "id": "k2-kickoff-04",
          "prompt": "When does a kickoff happen?",
          "choices": [
            "At the start of each half",
            "After every incomplete pass",
            "On every 3rd down",
            "Only in overtime"
          ],
          "answer": 0,
          "explanation": "Kickoffs start each half, and they come after touchdowns and field goals too.",
          "concept": "kickoff"
        },
        {
          "type": "true_false",
          "id": "k2-kickoff-05",
          "statement": "After a team scores a touchdown, that team kicks off to the other team.",
          "answer": true,
          "explanation": "The scoring team kicks, so the other team gets the ball.",
          "concept": "kickoff"
        },
        {
          "type": "multiple_choice",
          "id": "k2-kickoff-06",
          "prompt": "What does the kick returner try to do?",
          "choices": [
            "Kick the ball back",
            "Catch the kick and run it back",
            "Block the kicker",
            "Call a timeout"
          ],
          "answer": 1,
          "explanation": "The returner catches the ball and runs it back up the field.",
          "concept": "kick-returner"
        },
        {
          "type": "learn",
          "id": "k2-kickoff-07",
          "title": "Touchback",
          "body": "If the kick goes into the end zone and the returner stays there, it is a touchback. Play stops, and their team starts from a set spot on the field.",
          "concept": "touchback"
        },
        {
          "type": "true_false",
          "id": "k2-kickoff-08",
          "statement": "On a touchback, the receiving team gets the ball without running it out.",
          "answer": true,
          "explanation": "A touchback is a safe choice: no run, but a good starting spot.",
          "concept": "touchback"
        }
      ]
