    {
      "id": "k2-scoreboard",
      "title": "Reading the Scoreboard",
      "blurb": "What all the numbers mean.",
      "steps": [
        {
          "type": "learn",
          "id": "k2-scoreboard-01",
          "title": "The scoreboard",
          "body": "A scoreboard shows each team's score, the quarter, and the time left. It also shows the down, the yards to go, and where the ball is.",
          "concept": "scoreboard"
        },
        {
          "type": "learn",
          "id": "k2-scoreboard-02",
          "title": "Down and distance",
          "body": "\"3rd and 4\" means it is 3rd down and the offense needs 4 more yards for a first down.",
          "concept": "down-and-distance"
        },
        {
          "type": "multiple_choice",
          "id": "k2-scoreboard-03",
          "prompt": "The scoreboard says \"2nd and 7\". What does that mean?",
          "choices": [
            "2nd down, 7 yards to go",
            "2 yards on 7th down",
            "Quarter 2, 7 minutes left",
            "Team 2 has 7 points"
          ],
          "answer": 0,
          "explanation": "The first number is the down. The second is the yards needed.",
          "concept": "down-and-distance"
        },
        {
          "type": "multiple_choice",
          "id": "k2-scoreboard-04",
          "prompt": "\"4th and 1\": how many yards does the offense need?",
          "choices": [
            "1",
            "4",
            "10",
            "41"
          ],
          "answer": 0,
          "explanation": "One yard. It's 4th down, so this is the last try.",
          "concept": "down-and-distance"
        },
        {
          "type": "order",
          "id": "k2-scoreboard-05",
          "prompt": "Put the downs in order.",
          "items": [
            "1st down",
            "2nd down",
            "3rd down",
            "4th down"
          ],
          "explanation": "Downs count up from 1 to 4. A first down starts the count again.",
          "concept": "down"
        },
        {
          "type": "true_false",
          "id": "k2-scoreboard-06",
          "statement": "\"Ball on 30\" tells you where the ball is on the field.",
          "answer": true,
          "explanation": "It is the yard line where the next play starts.",
          "concept": "yard-line"
        },
        {
          "type": "multiple_choice",
          "id": "k2-scoreboard-07",
          "prompt": "What can you read on the scoreboard?",
          "choices": [
            "The score, the time and the down",
            "The weather",
            "The coach's plays",
            "Who is hurt"
          ],
          "answer": 0,
          "explanation": "The scoreboard tells you the score, the quarter, the clock, the down and the timeouts left.",
          "concept": "scoreboard"
        }
      ]
