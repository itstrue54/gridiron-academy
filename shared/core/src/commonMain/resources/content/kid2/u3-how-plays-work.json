        {
          "type": "multiple_choice",
          "id": "k2-runpass-03",
          "prompt": "Which play can gain lots of yards fast?",
          "choices": [
            "A pass",
            "A punt",
            "A timeout",
            "A kneel"
          ],
          "answer": 0,
          "explanation": "A long pass can gain many yards at once.",
          "concept": "pass-play"
        },
        {
          "type": "multiple_choice",
          "id": "k2-runpass-04",
          "prompt": "Which play is usually safer?",
          "choices": [
            "A run",
            "A long pass",
            "An onside kick",
            "A trick play"
          ],
          "answer": 0,
          "explanation": "Runs are less risky: there is no pass to drop or intercept.",
          "concept": "run-play"
        },
        {
          "type": "true_false",
          "id": "k2-runpass-05",
          "statement": "A pass can be intercepted by the defense.",
          "answer": true,
          "explanation": "That is one of the risks of passing.",
          "concept": "interception"
        },
        {
          "type": "multiple_choice",
          "id": "k2-runpass-06",
          "prompt": "It's 3rd down and 1 yard to go. What do many teams choose?",
          "choices": [
            "A short run",
            "A punt",
            "A very long pass",
            "A timeout"
          ],
          "answer": 0,
          "explanation": "With only 1 yard to go, a short, safe run is a common choice.",
          "concept": "run-play"
        }
      ]
